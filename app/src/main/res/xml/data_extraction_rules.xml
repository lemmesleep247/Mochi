<?xml version="1.0" encoding="utf-8"?>
<!--
    Governs cloud backup and device-to-device transfer on Android 12+.
    OAuth tokens and the MAL website session cookie are excluded — they're
    revocable, tied to this install, and not something we want leaving the
    device via backup or transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/mal_auth.preferences_pb" />
        <exclude domain="file" path="datastore/mal_cookie.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/mal_auth.preferences_pb" />
        <exclude domain="file" path="datastore/mal_cookie.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
