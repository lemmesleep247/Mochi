<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy Auto Backup rules, used below API 31 (see data_extraction_rules.xml
    for API 31+). Same exclusions: OAuth tokens and the MAL session cookie
    never leave the device via backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/mal_auth.preferences_pb" />
    <exclude domain="file" path="datastore/mal_cookie.preferences_pb" />
</full-backup-content>
