<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- All real theming happens in Compose (ui/theme/Theme.kt); this only sets the
         window background shown before Compose draws its first frame. -->
    <style name="Theme.Mochi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
